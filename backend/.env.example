# Salin menjadi .env dan sesuaikan.
APP_NAME=Perisai Nusantara (PN-X)
ENVIRONMENT=dev

# Dev lokal (tanpa Docker): SQLite
DATABASE_URL=sqlite:///./pnx_dev.db
# Produksi/Docker (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://pnx:pnx@db:5432/pnx

# WAJIB diganti di non-dev (mis. hasil: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=dev-insecure-change-me-0000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
MFA_TOKEN_TTL_MINUTES=5
TOTP_ISSUER=PN-X
